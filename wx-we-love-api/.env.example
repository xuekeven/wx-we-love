NODE_ENV=development
PORT=4000

# WeChat mini program login
WX_APPID=your_wechat_appid
WX_SECRET=your_wechat_secret

# JWT signing secret. Use a long random string in production.
JWT_SECRET=replace_with_a_long_random_secret

# MySQL. When DB_HOST is set, the app uses MySQL.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=wx_we_love
# DB_USER=root
# DB_PASSWORD=your_password

# SQLite fallback. Used when DB_HOST is not set.
SQLITE_STORAGE=./database.sqlite

# Public base URL used when generating uploaded file URLs.
API_BASE_URL=http://localhost:4000

# Comma-separated browser origins. Requests without Origin (for example WeChat)
# are accepted; production browser origins must be listed explicitly.
CORS_ORIGINS=http://localhost:10086

# Persistent upload storage. Back up this directory with the database.
UPLOAD_DIR=./uploads
