{
  "name": "wx-we-love-app",
  "version": "1.0.0",
  "private": true,
  "description": "情侣恋爱空间小程序 - 记录每一份甜蜜",
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:weapp:prod": "NODE_ENV=production taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,scss,json}\"",
    "clean": "rimraf dist"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.21.0",
    "@tarojs/components": "3.6.23",
    "@tarojs/helper": "3.6.23",
    "@tarojs/plugin-framework-react": "3.6.23",
    "@tarojs/plugin-platform-weapp": "3.6.23",
    "@tarojs/react": "3.6.23",
    "@tarojs/runtime": "3.6.23",
    "@tarojs/shared": "3.6.23",
    "@tarojs/taro": "3.6.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@tarojs/cli": "3.6.23",
    "@tarojs/taro-loader": "3.6.23",
    "@tarojs/webpack5-runner": "3.6.23",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^5.20.0",
    "@typescript-eslint/parser": "^5.20.0",
    "babel-preset-taro": "3.6.23",
    "eslint": "^8.12.0",
    "eslint-config-taro": "3.6.23",
    "eslint-plugin-react": "^7.29.4",
    "eslint-plugin-react-hooks": "^4.4.0",
    "eslint-plugin-import": "^2.26.0",
    "prettier": "^2.8.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.0",
    "rimraf": "^5.0.0",
    "sass": "^1.62.0",
    "typescript": "^5.0.0",
    "webpack": "^5.78.0"
  }
}